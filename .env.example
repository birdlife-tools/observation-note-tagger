# =============================================================================
# Observation Note Tagger - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.

# =============================================================================
# Database
# =============================================================================

DATABASE_URL=postgresql://ont:ont_dev@localhost:5432/ont

# =============================================================================
# Backend Selection (swap implementations without code changes)
# =============================================================================

# Repository backend: "postgres" or "memory" (memory for testing only)
ONT_REPO_BACKEND=postgres

# LLM adapter: "ollama", "claude", or "openai"
ONT_LLM_ADAPTER=ollama

# Validator: "grounding", "composite", or "none"
ONT_VALIDATOR=grounding

# File parser: "ebird" (more can be added: "csv", "inaturalist", etc.)
ONT_PARSER=ebird

# =============================================================================
# API Server (FastAPI)
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Ollama (local LLM, default)
# =============================================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# =============================================================================
# Claude (Anthropic) - for production use
# Set ONT_LLM_ADAPTER=claude and uncomment below
# =============================================================================

# ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_TIMEOUT=120

# =============================================================================
# Extractor Configuration
# =============================================================================

EXTRACTOR_BATCH_SIZE=10
EXTRACTOR_CONFIDENCE_THRESHOLD=0.85
# EXTRACTOR_MAX_RETRIES=3
# EXTRACTOR_PARALLEL_WORKERS=1

# =============================================================================
# Ingest Configuration
# =============================================================================

INGEST_BATCH_SIZE=1000
# INGEST_MAX_RETRIES=3
# INGEST_CHECKPOINT_INTERVAL=5000
# INGEST_STALE_TIMEOUT_MINUTES=30
