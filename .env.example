# Database
DATABASE_URL=postgresql://ont:ont_dev@localhost:5432/ont

# LLM
ONT_LLM_ADAPTER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Validator
ONT_VALIDATOR=grounding

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Extractor
EXTRACTOR_BATCH_SIZE=10
EXTRACTOR_CONFIDENCE_THRESHOLD=0.85

# Ingest
INGEST_BATCH_SIZE=1000
