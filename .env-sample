# =============================================================================
# Observation Note Tagger - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All values shown are defaults - uncomment and modify to override.

# =============================================================================
# Backend Selection (swap implementations without code changes)
# =============================================================================

# Repository backend: "postgres" or "memory" (memory for testing only)
# ONT_REPO_BACKEND=postgres

# LLM adapter: "ollama", "claude", or "openai"
# ONT_LLM_ADAPTER=ollama

# File parser: "ebird" (more can be added: "csv", "inaturalist", etc.)
# ONT_PARSER=ebird

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

DATABASE_URL=postgres://ont:ont_dev@localhost:5432/ont?sslmode=disable

# =============================================================================
# Extractor Configuration
# =============================================================================

# EXTRACTOR_BATCH_SIZE=10
# EXTRACTOR_MAX_RETRIES=3
# EXTRACTOR_CONFIDENCE_THRESHOLD=0.85
# EXTRACTOR_PARALLEL_WORKERS=1

# =============================================================================
# LLM Adapters
# =============================================================================

# --- Ollama (local LLM, default) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# --- Claude (Anthropic) - for production use ---
# Uncomment and set ONT_LLM_ADAPTER=claude to use
# ANTHROPIC_API_KEY=sk-ant-xxx
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_TIMEOUT=120

# --- OpenAI - alternative ---
# Uncomment and set ONT_LLM_ADAPTER=openai to use
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o
# OPENAI_TIMEOUT=120
